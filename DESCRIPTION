Package: multipointR
Title: A package to compare intensities of point patterns across samples with spatial parametric models
Version: 0.99.6
Authors@R:c( 
    person("Martin", "Emons", , "martin.emons@uzh.ch", role = c("aut", "cre"),
           comment = c(ORCID = "0009-0000-5219-5311")),
    person("Wolfgang", "Huber", , role="aut",
            comment = c(ORCID = "0000-0002-0474-2218")),
